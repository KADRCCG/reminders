PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/church_reminders
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Reminder cron (default: every day at 8:00 AM server time)
REMINDER_CRON=0 8 * * *
DEFAULT_REMINDER_DAYS=2

# Admin login (seed + synced when the API starts)
ADMIN_NAME=Admin
ADMIN_EMAIL=pastor@church.local
ADMIN_PASSWORD=pastor123

# Phone normalization for local numbers (e.g. 087... -> +35387...)
DEFAULT_PHONE_COUNTRY_CODE=+353

# --- SMS via SMSGate (Android phone gateway) — https://sms-gate.app ---
# Cloud: https://api.sms-gate.app/3rdparty/v1
# Local: http://PHONE_LAN_IP:8080/3rdparty/v1  (check /docs on the phone)
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
# Must be …/3rdparty/v1 (Cloud or Local). Do NOT use …/mobile/v1 — that path is only for the Android app.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=

# --- WhatsApp via Meta Cloud API (not Twilio) ---
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v21.0
# Optional: approved utility template with one body variable ({{1}} = full message).
# Leave blank to send free-form text (only works inside Meta's 24h customer-care window).
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANG=en

# Comma-separated phones that also receive celebration announcement digests on WhatsApp
CELEBRATION_WHATSAPP_TO=
